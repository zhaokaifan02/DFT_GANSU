.PHONY : src/uhf.i

# target to preprocess a source file
src/uhf.cu.i:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/gansu.dir/build.make CMakeFiles/gansu.dir/src/uhf.cu.i
.PHONY : src/uhf.cu.i

src/uhf.s: src/uhf.cu.s
.PHONY : src/uhf.s

# target to generate assembly for a file
